#!/bin/bash
# Builds MAFOT inside the SPACK builder image, against the spack view (/opt/views/view).
# Adapted from docker/buildMAFOT (the legacy build script). Differences:
#   * GPU and M3DC1 are driven by env vars (MAFOT_GPU / MAFOT_M3DC1) instead of hard-coded
#     GPU=True, so heat-builder.dockerfile can build CPU-only (Strategy A, both arches) or
#     with GPU (x86 only). make CLI assignments override make.inc.HEAT.spack's fallbacks.
#   * The caller (heat-builder.dockerfile) must have sourced the spack view env first, so
#     g++/gfortran/mpirun and the view's -L/-I paths resolve.
# make.inc.HEAT (symlinked below) is docker/make.inc.HEAT.spack, copied into the MAFOT tree
# by the Dockerfile — it points OMPLIBS/NETCDF*/HDF5LIBS at the view.
set -euo pipefail
: "${MAFOT_GPU:=False}"
: "${MAFOT_M3DC1:=False}"

echo "Building Blitz..."
cd /root/source/MAFOT/blitz++
tar -xvzf blitz-0.9_cstdlibPatched.tar.gz
cd blitz-0.9
# RISK (aarch64): blitz-0.9 (2009) ships an old config.guess/config.sub that predate
# aarch64 and can abort with "unrecognized host". If ./configure fails on arm, refresh
# them (e.g. copy newer config.guess/config.sub) before configuring.
./configure
make lib
make install

cd /root/source/MAFOT
rm -f make.inc
ln -s install/make.inc.HEAT make.inc
echo "Building MAFOT (heat targets: heatstructure + heatlaminar_mpi) GPU=${MAFOT_GPU} M3DC1=${MAFOT_M3DC1} ..."
# CLI assignments override make.inc.HEAT.spack, so this is authoritative regardless of the
# fallbacks in that file. GPU=True compiles CUDA into the binaries (cudart linked statically);
# M3DC1=True additionally links fusion-io + HDF5 C++ (requires the M3DC1 phase-2 build first
# and a view with libhdf5_cpp — see make.inc.HEAT.spack notes).
make GPU="${MAFOT_GPU}" M3DC1="${MAFOT_M3DC1}" heat
